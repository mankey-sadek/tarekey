{
  "name": "fi-tari2ak",
  "version": "1.0.0",
  "description": "Uber-like ride-hailing backend: WebSocket + H3 + CAS + state machine + message queue",
  "scripts": {
    "predev": "node ui/build.mjs",
    "dev": "tsx sim/live.ts",
    "prestart": "node ui/build.mjs",
    "start": "tsx src/index.ts",
    "sim": "tsx sim/simulator.ts",
    "test": "node --import tsx --test test/*.test.ts",
