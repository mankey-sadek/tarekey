    "bench": "tsx bench/locationBench.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "h3-js": "^4.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
